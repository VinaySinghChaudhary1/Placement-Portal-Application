<template>
  <div class="container py-4">
    <h3 class="mb-3">Summary / Report</h3>
    <div v-if="loading" class="text-center py-5"><span class="spinner-border text-primary"></span></div>
    <template v-else-if="report">
      <div class="row g-3">
        <div class="col-md-7">
          <div class="card p-3">
            <h6>Applications submitted, by month</h6>
            <canvas ref="lineChart" height="200"></canvas>
          </div>
        </div>
        <div class="col-md-5">
          <div class="card p-3">
            <h6>Applications by status</h6>
            <canvas v-if="hasStatusData" ref="pieChart" height="200"></canvas>
            <p v-else class="text-muted small mb-0">You haven't applied to any drives yet.</p>
          </div>
        </div>
      </div>
    </template>
  </div>
</template>

<script>
import Chart from 'chart.js/auto'
import studentService from '@/services/studentService'

export default {
  name: 'StudentReports',
  data() {
    return { report: null, loading: false, lineInstance: null, pieInstance: null }
  },
  computed: {
    hasStatusData() {
      return this.report && Object.keys(this.report.status_breakdown || {}).length > 0
    }
  },
  async created() {
    this.loading = true
    try {
      const { data } = await studentService.reports()
      this.report = data
      this.$nextTick(this.renderCharts)
    } finally { this.loading = false }
  },
  methods: {
    renderCharts() {
      if (this.$refs.lineChart) {
        if (this.lineInstance) this.lineInstance.destroy()
        this.lineInstance = new Chart(this.$refs.lineChart, {
          type: 'line',
          data: {
            labels: this.report.monthly_applications.map((m) => m.label),
            datasets: [{
              label: 'Applications',
              data: this.report.monthly_applications.map((m) => m.count),
              borderColor: '#0d6efd',
              backgroundColor: 'rgba(13,110,253,0.15)',
              tension: 0.3,
              fill: true
            }]
          },
          options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        })
      }
      if (this.$refs.pieChart && this.hasStatusData) {
        if (this.pieInstance) this.pieInstance.destroy()
        const labels = Object.keys(this.report.status_breakdown).map((k) => k.replace('_', ' '))
        const values = Object.values(this.report.status_breakdown)
        this.pieInstance = new Chart(this.$refs.pieChart, {
          type: 'pie',
          data: {
            labels,
            datasets: [{ data: values, backgroundColor: ['#0d6efd', '#fd7e14', '#6f42c1', '#198754', '#dc3545'] }]
          }
        })
      }
    }
  }
}
</script>
